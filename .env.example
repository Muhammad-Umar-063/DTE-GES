# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings → Database → Connection string (URI tab).
# Used by `npm run db:push` to apply migrations.
# Prefer the "Session pooler" connection (port 5432) on IPv4 networks,
# or the "Direct connection" if you have IPv6 access.
# Do NOT use the transaction pooler (port 6543) — it doesn't support DDL transactions.
DATABASE_URL=

# Used in a later phase (AI-assisted generation). Leave blank for now.
ANTHROPIC_API_KEY=
